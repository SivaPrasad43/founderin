# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public site URL (used for metadata). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. WhatsApp community invite link — never exposed to logged-out users.
WHATSAPP_COMMUNITY_URL=https://chat.whatsapp.com/your-invite-code
